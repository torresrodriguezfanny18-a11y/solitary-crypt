-- 5. CREACIÓN DE PESTAÑAS SUPERIORES
---------------------------------------------------------
local function CreateTabButton(name, text, iconAssetId, pageToSwitch)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = UDim2.new(0, 95, 0, 28)
    btn.AutoButtonColor = false
    btn.Text = ""
    btn.ZIndex = 2
    
    local isSelected = (pageToSwitch.Visible)
    btn.BackgroundColor3 = isSelected and Color3.fromRGB(25, 35, 50) or Color3.fromRGB(0, 0, 0)
    btn.BackgroundTransparency = isSelected and 0.2 or 0.6
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(255, 255, 255)
    stroke.Transparency = isSelected and 0.7 or 0.9
    stroke.Thickness = 1
    stroke.Parent = btn

    local icon = Instance.new("ImageLabel")
    icon.Parent = btn
    icon.Size = UDim2.new(0, 14, 0, 14)
    icon.Position = UDim2.new(0, 8, 0.5, -7)
    icon.BackgroundTransparency = 1
    icon.Image = iconAssetId
    icon.ImageColor3 = isSelected and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 160, 175)
    icon.ZIndex = 2

    local lbl = Instance.new("TextLabel")
    lbl.Parent = btn
    lbl.Size = UDim2.new(1, -26, 1, 0)
    lbl.Position = UDim2.new(0, 26, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = isSelected and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 160, 175)
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 2

    btn.MouseButton1Click:Connect(function()
        PageMain.Visible = false
        PagePlayer.Visible = false
        pageToSwitch.Visible = true
        
        for _, child in ipairs(TopTabsContainer:GetChildren()) do
            if child:IsA("TextButton") then
                child.BackgroundTransparency = 0.6
                child.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                if child:FindFirstChild("UIStroke") then
                    child.UIStroke.Transparency = 0.9
                end
                if child:FindFirstChild("TextLabel") then
                    child.TextLabel.TextColor3 = Color3.fromRGB(150, 160, 175)
                end
                if child:FindFirstChild("ImageLabel") then
                    child.ImageLabel.ImageColor3 = Color3.fromRGB(150, 160, 175)
                end
            end
        end
        
        btn.BackgroundTransparency = 0.2
        btn.BackgroundColor3 = Color3.fromRGB(25, 35, 50)
        stroke.Transparency = 0.7
        lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
        icon.ImageColor3 = Color3.fromRGB(255, 255, 255)
    end)

    btn.Parent = TopTabsContainer
    return btn
end

